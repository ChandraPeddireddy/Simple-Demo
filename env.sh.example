# env.sh.example — credential template.
#
# Copy to env.sh (which is gitignored), fill in real values, then:
#   chmod 600 env.sh
#   source env.sh
#   terraform plan
#
# NEVER commit env.sh. The CLIENT_SECRET is a live, expiring credential — keep it
# out of git, *.tfvars, Terraform state, and logs. For CI, inject these from the
# pipeline's secret store / Azure Key Vault instead of a file.

# --- Service Principal (OAuth M2M) — recommended, no CLI needed ---------------
export DATABRICKS_HOST="https://adb-XXXXXXXX.azuredatabricks.net"
export DATABRICKS_CLIENT_ID="<sp-application-id>"
export DATABRICKS_CLIENT_SECRET="<sp-oauth-secret>"

# --- Alternative: Personal Access Token (instead of the SP vars above) --------
# export DATABRICKS_HOST="https://adb-XXXXXXXX.azuredatabricks.net"
# export DATABRICKS_TOKEN="<pat>"
